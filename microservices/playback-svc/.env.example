# Copy to `.env` (gitignored) for local development. Spring Boot loads it automatically
# (see `spring.config.import` in application.yml) — no extra tooling needed.
# On Render, set these as real environment variables instead of shipping a .env file.

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Same Supabase project as catalog-svc, own schema (`playback`) — ALWAYS through the Supavisor
# pooler (port 6543, transaction mode), never the direct connection.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
SPRING_DATASOURCE_PASSWORD=your-database-password

# ── YouTube Data API v3 (Project-Info.md §16, §37) ──────────────────────────────────────────
# From Google Cloud Console > APIs & Services > Credentials, with "YouTube Data API v3" enabled.
# A plain API key is enough — search.list/videos.list are public read endpoints, no OAuth needed.
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_REGION_CODE=BG

# ── Other services ───────────────────────────────────────────────────────────────────────────
CATALOG_SVC_URL=http://localhost:8081

# ── Misc ──────────────────────────────────────────────────────────────────────────────────
PORT=8082

# Discogs personal access token (Settings -> Developers). Optional: without it the video-hint worker still asks Discogs, at 25 req/min.
DISCOGS_TOKEN=
