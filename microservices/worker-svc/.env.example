# Copy to `.env` (gitignored) for local development. Spring Boot loads it automatically
# (see `spring.config.import` in application.yml) — no extra tooling needed.
# On Render, set these as real environment variables instead of shipping a .env file.

# ── THIS SERVICE'S OWN PROVIDER CREDENTIALS ───────────────────────────────────────────────
# The point of this service: the background walk gets its own keys and its own rate-limit budget,
# so it can never again spend the ones a user request is waiting on. Do NOT reuse the keys from
# catalog-svc/.env or the rows in catalog.tidal_api_keys here — that would undo the whole split.

# TIDAL (https://developer.tidal.com) — a separate app/client from the one catalog-svc uses.
TIDAL_ENABLED=true
TIDAL_CLIENT_ID=your-worker-tidal-client-id
TIDAL_CLIENT_SECRET=your-worker-tidal-client-secret
TIDAL_COUNTRY_CODE=BG
# Client-side pacing. Lower it if TIDAL still answers 429; raise it once it doesn't.
TIDAL_MAX_RPS=3

# Last.fm (https://www.last.fm/api/account/create) — again a separate key from catalog-svc's.
LASTFM_ENABLED=true
LASTFM_API_KEY=your-worker-lastfm-api-key
LASTFM_MAX_RPS=3

# ── Services this worker feeds ────────────────────────────────────────────────────────────
CATALOG_SVC_URL=http://localhost:8081
PLAYBACK_SVC_URL=http://localhost:8082
RECOMMENDATION_SVC_URL=http://localhost:8083

# ── Misc ──────────────────────────────────────────────────────────────────────────────────
PORT=8084
# Each worker can be switched off on its own — handy while tuning one provider's pace.
DISCOGRAPHY_WORKER_ENABLED=true
GRAPH_WORKER_ENABLED=true
# Pause between artists in the discography walk. The knob that used to hurt user requests.
DISCOGRAPHY_DELAY=500ms
