# Copy to `.env` (gitignored) for local development. Spring Boot loads it automatically
# (see `spring.config.import` in application.yml) — no extra tooling needed.
# On Render, set these as real environment variables instead of shipping a .env file.

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Supabase Postgres — ALWAYS through the Supavisor pooler (port 6543, transaction mode), never
# the direct connection (port 5432). Find this under Project Settings > Database > Connection
# pooling in the Supabase dashboard. Keep hikari.maximum-pool-size small (see application.yml) —
# 7 services x a large pool exhausts Postgres' own connection limit fast.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
SPRING_DATASOURCE_PASSWORD=your-database-password

# ── TIDAL (Project-Info.md §12, §37) ─────────────────────────────────────────────────────────
# From a TIDAL Developer Portal app using the Client Credentials flow (server-to-server, no user
# login) — see docs/architecture/music-providers.md (or ask for the signup walkthrough) for how
# to create one at https://developer.tidal.com.
TIDAL_ENABLED=true
TIDAL_CLIENT_ID=your-tidal-client-id
TIDAL_CLIENT_SECRET=your-tidal-client-secret
# ISO 3166-1 alpha-2. Affects availability and search relevance on TIDAL's side.
TIDAL_COUNTRY_CODE=BG

# ── Misc ──────────────────────────────────────────────────────────────────────────────────
PORT=8081
