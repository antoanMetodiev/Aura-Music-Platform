# Copy to `.env` (gitignored) for local development. Spring Boot loads it automatically
# (see `spring.config.import` in application.yml). On Render, set these as real env vars.

# Where each backend service can be reached. Defaults assume every service runs locally on its
# own port; on Render this becomes each service's internal URL (or a service-discovery scheme
# later, if we ever introduce one — Project-Info.md §10 keeps the gateway config-driven for now).
CATALOG_SVC_URL=http://localhost:8081

# Comma-separated list of origins the browser is allowed to call this gateway from.
CORS_ALLOWED_ORIGINS=http://localhost:3000

PORT=8080
