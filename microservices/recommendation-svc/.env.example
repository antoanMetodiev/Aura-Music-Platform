# Copy to `.env` (gitignored) for local development. Spring Boot loads it automatically
# (see `spring.config.import` in application.yml) — no extra tooling needed.
# On Render, set these as real environment variables instead of shipping a .env file.

# ── Database ──────────────────────────────────────────────────────────────────────────────
# Same Supabase project as the other services, own schema (`recommendation`) — ALWAYS through the
# Supavisor pooler (port 6543, transaction mode), never the direct connection.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.your-project-ref
SPRING_DATASOURCE_PASSWORD=your-database-password

# ── Last.fm (taste graph) ─────────────────────────────────────────────────────────────────
# Free key from https://www.last.fm/api/account/create. The SAME key catalog-svc uses for artist
# biographies — one account, two integrations. Without it the graph worker does not start.
# NOTE: the free tier is non-commercial; see LastFmProperties before any commercial launch.
LASTFM_ENABLED=true
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_MAX_RPS=3

# ── Other services ────────────────────────────────────────────────────────────────────────
CATALOG_SVC_URL=http://localhost:8081
PLAYBACK_SVC_URL=http://localhost:8082

# ── Misc ──────────────────────────────────────────────────────────────────────────────────
PORT=8083
# Set to false to serve recommendations without building the graph any further.
GRAPH_SYNC_ENABLED=true
