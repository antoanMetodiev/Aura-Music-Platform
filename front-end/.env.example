# Backend API Gateway (Spring Cloud Gateway)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Where this app is served (absolute links, and where auth emails send people back to).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Auth (Project-Info.md §8, ADR-012) ---
# Dashboard -> Project Settings -> API. URL + anon key are public (the browser uses them too).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: account deletion (auth.admin). Never NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard -> Authentication:
#   URL Configuration -> Site URL: http://localhost:3000
#                     -> Redirect URLs: http://localhost:3000/api/auth/callback
#   Providers -> Email (confirm email as you like), Google (client id/secret from Google Cloud;
#                authorised redirect URI there: https://<project-ref>.supabase.co/auth/v1/callback)

# Our own Postgres for the `identity` schema (profiles, uploaded avatars). Same Supabase project as
# the services, through the Supavisor pooler (port 6543). Apply with `npm run db:migrate`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Never put provider secrets here (TIDAL, YouTube, Last.fm...). Those belong to the backend services.
